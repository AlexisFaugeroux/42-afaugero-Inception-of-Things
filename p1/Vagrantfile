require 'securerandom'

env_file = File.join(__dir__, ".env")
unless File.exist?(env_file)
	File.write(env_file, "K3S_TOKEN=#{SecureRandom.hex(32)}\n")
end

ENV_VARS = File.readlines(env_file)
	.map(&:strip).reject(&:empty?)
	.map { |line| line.split("=", 2) }.to_h

Vagrant.configure("2") do |config|
	config.vm.box = "debian/trixie64"
	config.vm.synced_folder ".", "/vagrant", disabled: true

	config.vm.provider :libvirt do |lv|
		lv.cpus = 1
		lv.memory = 1024
		lv.default_prefix = ""
	end

	config.vm.define "mpelageS" do |server|
		server.vm.hostname = "mpelageS"
		server.vm.network "private_network", ip: "192.168.56.110"
		server.vm.provision "shell", path: "scripts/server.sh", env: ENV_VARS
	end

	config.vm.define "mpelageSW" do |worker|
		worker.vm.hostname = "mpelageSW"
		worker.vm.network "private_network", ip: "192.168.56.111"
		worker.vm.provision "shell", path: "scripts/worker.sh", env: ENV_VARS
	end
end
