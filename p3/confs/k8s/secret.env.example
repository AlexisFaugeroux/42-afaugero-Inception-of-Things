# Copy this file to secret.env and replace every value.
# secret.env is ignored by Git: never commit real values.

POSTGRES_PASSWORD=changeme
JWT_SECRET=changeme

# Must match POSTGRES_USERNAME and POSTGRES_DB (config.env) and POSTGRES_PASSWORD above.
# The host is "db", the name of the PostgreSQL Service.
POSTGRES_URL=postgresql://changeme:changeme@db:5432/changeme?schema=public
